{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/app", "destination": "/api/index" },
    { "source": "/admin", "destination": "/api/index" },
    { "source": "/uploads/:path*", "destination": "/api/index" }
  ]
}
