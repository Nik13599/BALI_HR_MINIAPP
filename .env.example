BALI_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/bali
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_BOT_URL=https://t.me/replace_me
SESSION_SECRET=replace_with_at_least_32_random_characters
SESSION_TTL_SECONDS=2592000
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace_with_a_strong_password
TRUST_PROXY=0
BALI_UPLOAD_DIR=var/uploads
BACKUP_DIRECTORY=backups
